# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/.next-production/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local TravelMate repository data (created and seeded at runtime)
data/travelmate.json

# Temporary signed session for an isolated live visit-recording check
.trip-visits-live-fixture.json

# Local diagnostics and credentials are not project source.
*.log
.cache/
*.key
*.p12
*.pfx
*.db
*.sqlite
*.sqlite3
*.dump
credentials*.json
*service-account*.json

# One-off checks tied to private browser profiles / a private trip.
/scripts/check-existing-browser-session.mjs
/scripts/verify-actual-cheonan-back.mjs
